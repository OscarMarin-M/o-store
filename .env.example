# Copia este archivo como .env y completa los valores. El archivo .env no se sube a git.
# Todos los valores salen del panel de Supabase del proyecto de desarrollo.

# Project Settings > API (o botón "Connect"): URL del proyecto, https://<ref>.supabase.co
SUPABASE_URL=

# Project Settings > API Keys: clave pública (sb_publishable_... o "anon"). Puede ir en el navegador.
SUPABASE_PUBLISHABLE_KEY=

# Project Settings > API Keys: clave secreta (sb_secret_... o "service_role"). Solo la usa la API. Nunca en el front.
SUPABASE_SECRET_KEY=

# Botón "Connect" > Connection string > Session pooler (URI), con la contraseña de la base de datos.
DATABASE_URL=

# Puerto de la API NestJS
PORT=3000

# Dominio de la plataforma: cada tienda queda en <slug>.<PLATFORM_DOMAIN>. En desarrollo, localhost.
PLATFORM_DOMAIN=localhost

# Opcional: firma los códigos de verificación de dominios. Si falta se usa SUPABASE_SECRET_KEY.
DOMAIN_VERIFY_SECRET=

# Tipo de cambio de respaldo: cuántos bolivianos vale 1 dólar. Se usa mientras no esté conectado el del Banco Central de Bolivia.
USD_BOB_RATE=6.96
